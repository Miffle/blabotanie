{
  "name": "blabotanie",
  "version": "3.0.4",
  "description": "Звоночки-говорочки",
  "author": {
    "name": "ftliwdt",
    "email": "miffle1337@mail.ru"
  },
  "main": "main.js",
  "scripts": {
    "start": "npm run build-frontend && electron .",
    "build-frontend": "cd blabotanie-front && npm install && npm run build",
    "dist": "npm run build-frontend && electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@stomp/stompjs": "^5.4.0",
    "electron-updater": "^6.6.2",
    "react-hotkeys-hook": "^5.1.0",
    "sockjs-client": "^1.5.0"
  },
  "devDependencies": {
    "cpx": "^1.2.1",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.blabotanie.app",
    "productName": "Blabotanie",
    "icon": "resources/icon/icon256.ico",
    "protocols": [
      {
        "name": "Blabotanie",
        "schemes": [
          "blabotanie"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Miffle",
        "repo": "blabotanie"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "miffle1337@mail.ru",
      "icon": "resources/icon/icon256.png"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon/icon256.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "resources/icon/icon256.icns"
    },
    "asar": true
  }
}
